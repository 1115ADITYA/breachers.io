# ==============================================================================
# BREACHERS.IO — BACKEND PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Configure these in your backend hosting platform (Render, Railway, Fly.io, etc.).
# ==============================================================================

# Server Listening Port (Automatically populated by Render/Railway/Heroku/Fly.io)
PORT=8081

# Active Spring Profiles (Set to 'prod' for PostgreSQL production, omit for H2 in-memory)
SPRING_PROFILES_ACTIVE=prod

# Allowed CORS Origins (Comma-separated origins, or wildcard patterns like https://*.vercel.app)
CORS_ALLOWED_ORIGINS=https://breachers.vercel.app,https://*.vercel.app

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Pick Option A or Option B)
# ------------------------------------------------------------------------------

# Option A: Standard Single Cloud URI (Render / Railway / Supabase / Neon default)
# The backend automatically normalizes postgres:// and postgresql:// URIs to JDBC format!
DATABASE_URL=postgres://breachers_user:your_secure_password_here@dpg-xxxxxx.oregon-postgres.render.com:5432/breachers_db

# Option B: Standard Spring JDBC Datasource Variables
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-postgres-host:5432/breachers_db
# SPRING_DATASOURCE_USERNAME=breachers_user
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Optional: Connection Pool & Logging Configuration
DB_POOL_SIZE=10
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
