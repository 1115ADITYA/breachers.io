# ==============================================================================
# BREACHERS.IO — MONOREPO PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# This file provides a centralized reference of all environment variables used
# across the Vite frontend and Spring Boot backend services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------

# Base URL for backend HTTP endpoints (Health probe, Servlet report)
VITE_API_BASE_URL=https://breachers-io.onrender.com

# WebSocket endpoint URL for multiplayer combat & physics synchronization
VITE_WS_URL=wss://breachers-io.onrender.com/ws/game

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Set in Render / Railway / Fly.io / AWS)
# ------------------------------------------------------------------------------

# Service port (Provided automatically by most hosting services)
PORT=8081

# Active Spring Profile ('prod' enables PostgreSQL, omit for local H2)
SPRING_PROFILES_ACTIVE=prod

# Allowed frontend origins for CORS and WebSocket handshake
CORS_ALLOWED_ORIGINS=https://breachers.vercel.app,https://*.vercel.app

# PostgreSQL Database Connection (Option A: Cloud URI)
DATABASE_URL=postgres://breachers_admin:your_secure_password_here@your-postgres-host:5432/breachers_db

# PostgreSQL Database Connection (Option B: Discrete JDBC Variables)
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-postgres-host:5432/breachers_db
# SPRING_DATASOURCE_USERNAME=breachers_admin
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Runtime tuning
DB_POOL_SIZE=10
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
