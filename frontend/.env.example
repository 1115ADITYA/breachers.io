# ==============================================================================
# BREACHERS.IO — FRONTEND PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Configure these in the Vercel Project Settings > Environment Variables.
# For local development, copy this file to frontend/.env (optional; defaults to localhost:8081).
# ==============================================================================

# Backend HTTP/HTTPS Base URL (e.g., https://breachers-io.onrender.com)
# Used for Servlet match report links and HTTP API endpoints.
VITE_API_BASE_URL=https://breachers-io.onrender.com

# Backend WebSocket URL (e.g., wss://breachers-io.onrender.com/ws/game)
# Note: Use 'wss://' for secure HTTPS production hosting, 'ws://' for local HTTP.
VITE_WS_URL=wss://breachers-io.onrender.com/ws/game
